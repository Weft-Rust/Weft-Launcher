{
  "$schema": "https://schema.tauri.app/config/2.json",
  "productName": "Weft Launcher",
  "version": "1.2.0",
  "identifier": "dev.weft.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
  {
    "title": "Weft Launcher",
    "width": 960,
    "height": 565,
    "minWidth": 960,
    "minHeight": 565,
    "center": true
  }
],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDOTZBNEIyRjlFNTIwRkMKUldUOElPWDVzcVNXL0VtM0J1SGg5d3ltcWZyeVNqNDE4OHlsT2JlWkUzSlk3elFaeTZHSCs3YVUK",
      "endpoints": ["https://github.com/Weft-Rust/Weft-Launcher/releases/latest/download/latest.json"]
    }
  }
}
